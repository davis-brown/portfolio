---
import Page from '../layouts/Page.astro';
import Spine from '../components/Spine.astro';
---

<Page title="Not found" description="That page does not exist.">
  <div class="spine-grid">
    <Spine size={18} variant="accent" top={80} />
    <section class="nf">
      <p class="eyebrow">404 · no such path</p>
      <h1>That page doesn’t exist.</h1>
      <p class="lead">
        The link may be stale, or the page may have moved. Everything else is still here.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="/">Back home →</a>
        <a class="btn btn-outline" href="/projects">See the project</a>
      </div>
    </section>

    <Spine size={10} variant="mute" top={8} lineHeight={20} />
    <div></div>
  </div>
</Page>

<style>
  .nf { padding: var(--s-64) 0 var(--s-88); }
  .eyebrow { margin-bottom: var(--s-16); }
  h1 {
    font: 600 var(--t-64) / 1.02 var(--sans);
    letter-spacing: -0.04em;
    text-wrap: balance;
    max-width: 16ch;
  }
  .lead { margin-top: var(--s-20); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--s-12); margin-top: var(--s-32); }

  @media (max-width: 900px) {
    .nf { padding: var(--s-48) 0 var(--s-64); }
    h1 { font-size: 40px; }
  }
  @media (max-width: 600px) { h1 { font-size: 34px; } }
</style>
