---
/**
 * Posts to a form service (Formspree / Web3Forms) — set `contact.formEndpoint`
 * in src/data/site.ts. The plain form works with JS disabled; the script below
 * adds inline validation and swaps in the success line without a page load.
 */
import { contact } from '../data/site';

const endpoint = contact.formEndpoint;
---

<form
  class="form"
  method="POST"
  action={endpoint || undefined}
  data-contact-form
  data-configured={endpoint ? 'true' : 'false'}
  novalidate
>
  <div class="field">
    <label for="cf-name">name</label>
    <input id="cf-name" name="name" type="text" placeholder="Your name" required autocomplete="name" />
    <p class="error" data-error-for="name" hidden></p>
  </div>

  <div class="field">
    <label for="cf-email">email</label>
    <input id="cf-email" name="email" type="email" placeholder="you@company.com" required autocomplete="email" />
    <p class="error" data-error-for="email" hidden></p>
  </div>

  <div class="field wide">
    <label for="cf-message">message</label>
    <textarea
      id="cf-message"
      name="message"
      placeholder="Role, team, timeline — or just what you're building."
      required></textarea>
    <p class="error" data-error-for="message" hidden></p>
  </div>

  {/* Honeypot — bots fill it, people never see it. */}
  <div class="hp" aria-hidden="true">
    <label for="cf-company">company</label>
    <input id="cf-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="foot wide">
    <span class="hint">{contact.formHint}</span>
    <button class="btn btn-primary" type="submit">Send message →</button>
  </div>

  <p class="form-status wide" data-form-status role="status" hidden></p>
</form>

<p class="success wide" data-form-success hidden>{contact.success}</p>

<style>
  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-16);
  }
  .wide { grid-column: 1 / -1; }

  .field { display: flex; flex-direction: column; gap: 6px; }
  label {
    font: var(--t-13) / 1.2 var(--mono);
    color: var(--mute);
  }
  input,
  textarea {
    background: var(--bg2);
    border: 1px solid var(--line);
    border-radius: var(--r-btn);
    padding: 0 var(--s-14);
    height: 52px;
    font: var(--t-16) / 1.4 var(--sans);
    width: 100%;
  }
  textarea {
    min-height: 160px;
    padding: var(--s-14);
    resize: vertical;
  }
  input::placeholder,
  textarea::placeholder { color: var(--mute); }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--acc);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }
  [aria-invalid='true'] { border-color: var(--warn); }

  .error {
    font: var(--t-13) / 1.4 var(--mono);
    color: var(--warn);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-16);
    flex-wrap: wrap;
  }
  .hint {
    font: var(--t-13) / 1.4 var(--mono);
    color: var(--mute);
  }

  .form-status {
    font: var(--t-14) / 1.5 var(--mono);
    color: var(--warn);
  }
  .success {
    font: var(--t-20) / 1.5 var(--sans);
    color: var(--acc);
  }

  /* Honeypot: off-screen rather than display:none, which some bots detect. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .form { grid-template-columns: 1fr; }
    .foot { flex-direction: column; align-items: stretch; }
    .foot .btn { justify-content: center; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const success = document.querySelector<HTMLElement>('[data-form-success]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form && success && status) {
    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const showError = (name: string, message: string) => {
      const field = form.querySelector<HTMLElement>(`[name="${name}"]`);
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (field) field.setAttribute('aria-invalid', 'true');
      if (slot) {
        slot.textContent = message;
        slot.hidden = false;
      }
    };

    const clearErrors = () => {
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });
      status.hidden = true;
    };

    const validate = () => {
      clearErrors();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      let first: string | null = null;

      if (!name) { showError('name', 'required'); first ??= 'name'; }
      if (!email) { showError('email', 'required'); first ??= 'email'; }
      else if (!EMAIL.test(email)) { showError('email', 'that address looks off'); first ??= 'email'; }
      if (!message) { showError('message', 'required'); first ??= 'message'; }

      if (first) form.querySelector<HTMLElement>(`[name="${first}"]`)?.focus();
      return !first;
    };

    form.addEventListener('submit', async (e) => {
      // Always validate first, whether or not we can submit over fetch.
      if (!validate()) {
        e.preventDefault();
        return;
      }

      // No endpoint configured yet — say so rather than posting nowhere.
      if (form.dataset.configured !== 'true') {
        e.preventDefault();
        status.textContent =
          'Form endpoint not configured yet — set contact.formEndpoint in src/data/site.ts.';
        status.hidden = false;
        return;
      }

      e.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      button?.setAttribute('disabled', 'true');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) {
          // The endpoint returns { ok, error } — prefer its message.
          const detail = await res.json().catch(() => null);
          throw new Error(detail?.error || String(res.status));
        }
        form.hidden = true;
        success.hidden = false;
        success.focus?.();
      } catch (err) {
        button?.removeAttribute('disabled');
        status.textContent =
          err instanceof Error && err.message && !/^\d+$/.test(err.message)
            ? err.message
            : 'That did not send. Email me directly and I will get it.';
        status.hidden = false;
      }
    });
  }
</script>
