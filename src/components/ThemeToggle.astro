---
/**
 * 8px accent dot + the current theme's name.
 * The label is written by script on load so it can never disagree with the
 * theme the no-flash script chose; it ships as "dark" to match the markup default.
 */
---

<button type="button" class="toggle" id="theme-toggle" aria-live="polite">
  <span class="dot" aria-hidden="true"></span>
  <span class="sr-only">Theme:</span>
  <span class="label" data-theme-label>dark</span>
</button>

<style>
  .toggle {
    display: flex;
    align-items: center;
    gap: var(--s-8);
    margin-left: var(--s-10);
    padding: 12px 14px;
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--r-btn);
    font: var(--t-13) / 1 var(--mono);
    cursor: pointer;
  }
  .toggle:hover { border-color: var(--acc); color: var(--acc); }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--acc);
    flex: none;
  }
  @media (max-width: 600px) {
    .toggle { margin-left: 0; padding: 10px; }
    .label { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;

    function paint() {
      var t = root.getAttribute('data-theme') || 'dark';
      document.querySelectorAll('[data-theme-label]').forEach(function (el) {
        el.textContent = t;
      });
    }

    /* Exposed so the terminal's `theme` command reuses this rather than
       reimplementing persistence. */
    window.__toggleTheme = function () {
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* storage blocked — the toggle still works for this page view */
      }
      paint();
      window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
      return next;
    };

    paint();
    var btn = document.getElementById('theme-toggle');
    if (btn) btn.addEventListener('click', window.__toggleTheme);
  })();
</script>
