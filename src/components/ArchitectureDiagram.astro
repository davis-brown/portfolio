---
/**
 * Pull Up's deployment topology, drawn from the project's own wrangler config
 * rather than sketched: an Expo client on three surfaces, a Cloudflare Worker
 * that proxies into a Go container, and Neon Postgres behind it.
 *
 * Inline SVG rather than an <img> so it paints in the site's design tokens and
 * follows the theme toggle instantly. One file, no second asset to keep in sync.
 */
---

<figure class="diagram">
  <svg viewBox="0 0 800 304" role="img" aria-labelledby="arch-title arch-desc">
    <title id="arch-title">Pull Up architecture</title>
    <desc id="arch-desc">
      An Expo client on iOS, Android and web pulls map tiles straight from
      OpenFreeMap and calls a Cloudflare Worker. The Worker proxies into a Go
      API running in a Cloudflare Container, which reads and writes a Neon
      Postgres database with PostGIS and seeds courts from the OpenStreetMap
      Overpass API. The Worker also holds the R2 photo bucket, transactional
      email, and an hourly cron that drains background work.
    </desc>

    <defs>
      <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--acc)" />
      </marker>
      <marker id="ah-mute" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--mute)" />
      </marker>
    </defs>

    <!-- external sources -->
    <g class="ext">
      <rect x="8" y="8" width="168" height="40" rx="4" />
      <text class="mono" x="92" y="33">OpenFreeMap tiles</text>

      <rect x="432" y="8" width="156" height="40" rx="4" />
      <text class="mono" x="510" y="33">OSM Overpass</text>
    </g>

    <!-- main spine -->
    <g class="node">
      <rect x="8" y="104" width="168" height="96" rx="6" />
      <text class="t" x="92" y="134">Clients</text>
      <text class="s" x="92" y="157">iOS · Android · web</text>
      <text class="s" x="92" y="177">Expo · MapLibre</text>

      <rect x="220" y="104" width="168" height="96" rx="6" />
      <text class="t acc" x="304" y="134">pull-up-api</text>
      <text class="s" x="304" y="157">Cloudflare Worker</text>
      <text class="s" x="304" y="177">edge, no cold DB</text>

      <rect x="432" y="104" width="156" height="96" rx="6" />
      <text class="t" x="510" y="134">Go API</text>
      <text class="s" x="510" y="157">chi · pgx + sqlc</text>
      <text class="s" x="510" y="177">Container</text>

      <rect x="632" y="104" width="160" height="96" rx="6" />
      <text class="t" x="712" y="134">Neon</text>
      <text class="s" x="712" y="157">Postgres</text>
      <text class="s acc-s" x="712" y="177">+ PostGIS</text>
    </g>

    <!-- worker bindings -->
    <g class="ext">
      <rect x="220" y="248" width="368" height="44" rx="4" />
      <text class="mono" x="404" y="275">R2 photos · email · hourly cron drain</text>
    </g>

    <!-- flow -->
    <g class="flow">
      <line x1="176" y1="152" x2="220" y2="152" marker-end="url(#ah)" />
      <line x1="388" y1="152" x2="432" y2="152" marker-end="url(#ah)" />
      <line x1="588" y1="152" x2="632" y2="152" marker-end="url(#ah)" />
    </g>

    <!-- side flows, dashed: these bypass the API entirely -->
    <g class="flow dashed">
      <line x1="92" y1="48" x2="92" y2="104" marker-end="url(#ah-mute)" />
      <line x1="510" y1="48" x2="510" y2="104" marker-end="url(#ah-mute)" />
      <line x1="304" y1="200" x2="304" y2="248" marker-end="url(#ah-mute)" />
    </g>

    <text class="mono cap" x="102" y="84">no API key</text>
    <text class="mono cap" x="518" y="92">court seed</text>
  </svg>
</figure>

<style>
  .diagram {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--bg);
    padding: var(--s-20);
  }
  svg { width: 100%; height: auto; display: block; }

  .node rect {
    fill: var(--bg2);
    stroke: var(--line);
    stroke-width: 1;
  }
  .ext rect {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  text { text-anchor: middle; }
  .t {
    font: 600 16px/1 var(--sans);
    fill: var(--ink);
    letter-spacing: -0.01em;
  }
  .t.acc { fill: var(--acc); font-family: var(--mono); font-size: 15px; }
  .s {
    font: 12.5px/1 var(--mono);
    fill: var(--mute);
  }
  .s.acc-s { fill: var(--acc); }
  .mono {
    font: 12.5px/1 var(--mono);
    fill: var(--mute);
  }
  .cap { text-anchor: start; font-size: 11.5px; }

  .flow line {
    stroke: var(--acc);
    stroke-width: 1.5;
  }
  .flow.dashed line {
    stroke: var(--mute);
    stroke-dasharray: 4 4;
  }
</style>
