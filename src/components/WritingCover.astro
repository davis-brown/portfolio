---
/**
 * Fallback cover for the featured post when its frontmatter sets no `cover`.
 *
 * Draws the same commit graph the page chrome already implies with its spine,
 * so the card reads as part of the site rather than as stock art. Inline SVG so
 * it uses the design tokens and follows the theme toggle.
 */
---

<div class="cover" aria-hidden="true">
  <svg viewBox="0 0 480 320" preserveAspectRatio="xMidYMid slice">
    <g class="edges">
      <!-- the trunk runs past the viewBox so `slice` cropping reads as
           intentional bleed rather than a severed line -->
      <path d="M-40 160 H520" />
      <path d="M140 160 C170 160 170 102 200 102 H240 C270 102 270 160 300 160" />
      <path d="M215 160 C243 160 243 222 271 222 H316 C346 222 346 160 376 160" />
    </g>

    <g class="nodes">
      <circle class="mute" cx="75" cy="160" r="5" />
      <circle class="acc" cx="140" cy="160" r="7" />
      <circle class="mute" cx="215" cy="160" r="5" />
      <circle class="acc" cx="300" cy="160" r="7" />
      <circle class="mute" cx="376" cy="160" r="5" />
      <circle class="acc" cx="424" cy="160" r="9" />

      <circle class="hollow" cx="200" cy="102" r="6" />
      <circle class="hollow" cx="240" cy="102" r="6" />

      <circle class="hollow" cx="271" cy="222" r="6" />
      <circle class="hollow" cx="316" cy="222" r="6" />
    </g>
  </svg>
</div>

<style>
  .cover {
    position: absolute;
    inset: 0;
    background: var(--bg2);
    overflow: hidden;
  }
  svg { width: 100%; height: 100%; display: block; }

  .edges path {
    fill: none;
    stroke: var(--line);
    stroke-width: 2;
  }
  .nodes circle.mute  { fill: var(--mute); opacity: 0.55; }
  .nodes circle.acc   { fill: var(--acc); }
  .nodes circle.big   { filter: drop-shadow(0 0 0 var(--bg2)); }
  .nodes circle.hollow {
    fill: var(--bg2);
    stroke: var(--mute);
    stroke-width: 2;
    opacity: 0.8;
  }
</style>
