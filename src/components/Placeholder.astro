---
/**
 * Image slot. Renders a striped placeholder with a bracketed caption until a
 * real asset is passed in `src` — at which point the caption and the stripes
 * disappear with no markup change at the call site.
 */
interface Props {
  caption: string;
  src?: string;
  alt?: string;
  minHeight?: number;
  aspect?: string;
  rounded?: boolean;
  bordered?: boolean;
  class?: string;
}
const {
  caption,
  src,
  alt = '',
  minHeight,
  aspect,
  rounded = false,
  bordered = false,
  class: className,
} = Astro.props;

const style = [
  minHeight ? `min-height: ${minHeight}px` : '',
  aspect ? `aspect-ratio: ${aspect}` : '',
].filter(Boolean).join('; ');
---

<div
  class:list={['ph', className, { rounded, bordered, empty: !src }]}
  style={style}
>
  {src ? <img src={src} alt={alt} /> : <span class="caption">{caption}</span>}
  <slot />
</div>

<style>
  .ph {
    position: relative;
    background: var(--bg2);
    overflow: hidden;
  }
  .ph.empty {
    background-image: var(--stripe);
  }
  .ph.rounded { border-radius: var(--r-card); }
  .ph.bordered { border: 1px solid var(--line); }
  .caption {
    position: absolute;
    left: 14px;
    top: 12px;
    right: 14px;
    font: var(--t-12) / 1.4 var(--mono);
    color: var(--mute);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
