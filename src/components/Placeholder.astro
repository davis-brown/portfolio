---
/**
 * Image slot. Renders a striped placeholder with a bracketed caption until a
 * real asset is passed in `src` — at which point the caption and the stripes
 * disappear with no markup change at the call site.
 *
 * `srcDark` pairs a dark-mode capture with the light one. Both are rendered and
 * swapped in CSS on the `data-theme` attribute, so the image tracks the theme
 * toggle instantly rather than waiting on a media query the toggle overrides.
 */
interface Props {
  caption: string;
  src?: string;
  srcDark?: string;
  alt?: string;
  minHeight?: number;
  aspect?: string;
  rounded?: boolean;
  bordered?: boolean;
  class?: string;
}
const {
  caption,
  src,
  srcDark,
  alt = '',
  minHeight,
  aspect,
  rounded = false,
  bordered = false,
  class: className,
} = Astro.props;

const style = [
  minHeight ? `min-height: ${minHeight}px` : '',
  aspect ? `aspect-ratio: ${aspect}` : '',
].filter(Boolean).join('; ');
---

<div
  class:list={['ph', className, { rounded, bordered, empty: !src }]}
  style={style}
>
  {
    src ? (
      srcDark ? (
        <>
          <img class="theme-light" src={src} alt={alt} loading="lazy" decoding="async" />
          <img class="theme-dark" src={srcDark} alt={alt} loading="lazy" decoding="async" />
        </>
      ) : (
        <img src={src} alt={alt} loading="lazy" decoding="async" />
      )
    ) : (
      <span class="caption">{caption}</span>
    )
  }
  <slot />
</div>

<style>
  .ph {
    position: relative;
    background: var(--bg2);
    overflow: hidden;
  }
  .ph.empty {
    background-image: var(--stripe);
  }
  .ph.rounded { border-radius: var(--r-card); }
  .ph.bordered { border: 1px solid var(--line); }
  .caption {
    position: absolute;
    left: 14px;
    top: 12px;
    right: 14px;
    font: var(--t-12) / 1.4 var(--mono);
    color: var(--mute);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The site ships dark and stamps data-theme before first paint, so dark is
     the default and light is the override. Both images are in the DOM; only
     one is ever displayed. */
  .theme-light { display: none; }
  .theme-dark { display: block; }
  :global([data-theme='light']) .theme-light { display: block; }
  :global([data-theme='light']) .theme-dark { display: none; }
</style>
