{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "davisbrown-portfolio",
  "compatibility_date": "2026-09-11",

  // Assets-only Worker: no `main`, so no code runs at all. Every request is
  // served straight from Astro's static output, free and unlimited.
  // The contact form posts to Web3Forms rather than a server endpoint here,
  // because the free Cloudflare send path needs Email Routing on the apex —
  // which would displace SimpleLogin and break contact@davisbrown.dev.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
